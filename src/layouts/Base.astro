---
const { title, description = '' } = Astro.props;
const full = title === 'ギアクラブ' ? title : `${title} | ギアクラブ`;
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{full}</title>
    <meta name="description" content={description} />
    <style is:global>
      :root {
        --bg: #f7f8f8; --surface: #ffffff; --text: #1c2326; --muted: #5d6a6f;
        --line: #d9dfe1; --accent: #0f6b63; --accent-bg: #e4f1ef;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #131819; --surface: #1b2224; --text: #e8eceb; --muted: #9aa8ab;
          --line: #2d383b; --accent: #5cc4b8; --accent-bg: #1c3532;
        }
      }
      * { box-sizing: border-box; }
      body {
        margin: 0; background: var(--bg); color: var(--text);
        font-family: "Hiragino Sans", "Yu Gothic UI", "Meiryo", system-ui, sans-serif;
        line-height: 1.8;
      }
      a { color: var(--accent); }
      a:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
      header, main, footer { max-width: 860px; margin: 0 auto; padding: 0 20px; }
      header { display: flex; justify-content: space-between; align-items: baseline; padding-top: 20px; padding-bottom: 12px; border-bottom: 1px solid var(--line); }
      header .logo { font-size: 1.25rem; font-weight: 700; color: var(--text); text-decoration: none; }
      main { padding-top: 28px; padding-bottom: 48px; }
      h1 { font-size: 1.6rem; line-height: 1.4; margin: 0 0 8px; }
      .lead { color: var(--muted); margin: 0 0 24px; }
      .list { list-style: none; padding: 0; margin: 0; display: grid; gap: 12px; }
      .item { background: var(--surface); border: 1px solid var(--line); border-radius: 8px; padding: 16px 18px; display: grid; grid-template-columns: auto 1fr auto; gap: 16px; align-items: center; }
      .rank { font-size: 1.5rem; font-weight: 700; color: var(--accent); min-width: 2rem; }
      .name { font-weight: 700; }
      .meta { color: var(--muted); font-size: 0.9rem; }
      .btn { display: inline-block; background: var(--accent); color: var(--surface); padding: 8px 14px; border-radius: 6px; text-decoration: none; font-size: 0.9rem; }
      .table-wrap { overflow-x: auto; border: 1px solid var(--line); border-radius: 8px; background: var(--surface); }
      table { border-collapse: collapse; width: 100%; min-width: 520px; }
      th, td { padding: 10px 14px; text-align: left; border-bottom: 1px solid var(--line); white-space: nowrap; }
      thead th { background: var(--accent-bg); }
      tbody tr:last-child td, tbody tr:last-child th { border-bottom: 0; }
      .tabs { display: flex; gap: 8px; margin: 0 0 20px; }
      .tabs a { padding: 6px 12px; border: 1px solid var(--line); border-radius: 6px; text-decoration: none; color: var(--text); }
      .tabs a[aria-current="page"] { background: var(--accent-bg); border-color: var(--accent); color: var(--accent); }
      footer { padding-top: 16px; padding-bottom: 32px; border-top: 1px solid var(--line); color: var(--muted); font-size: 0.85rem; }
      @media (max-width: 560px) { .item { grid-template-columns: auto 1fr; } .item .btn { grid-column: 1 / -1; text-align: center; } }
    </style>
  </head>
  <body>
    <header>
      <a class="logo" href="/">ギアクラブ</a>
      <span class="meta">ガジェット・オーディオの比較</span>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <p>当サイトはアフィリエイト広告を利用しています。商品リンクから購入されると、運営者に報酬が入ることがあります。</p>
    </footer>
  </body>
</html>
