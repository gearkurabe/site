---
const { title, description = '' } = Astro.props;
const full = title === 'ギアクラブ' ? title : `${title} | ギアクラブ`;
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{full}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='8' fill='%23ff5a1f'/%3E%3Cpath d='M9 21c0-7 3-10 7-10s7 3 7 10' fill='none' stroke='white' stroke-width='3' stroke-linecap='round'/%3E%3C/svg%3E" />
    <style is:global>
      :root {
        --bg: #faf7f2; --surface: #ffffff; --text: #14110f; --muted: #5c554d; --line: #e4ddd0;
        --accent: #ff5a1f; --accent-text: #c93d08; --tint: #fff0e6;
        --badge-bg: #ffe9df; --badge-ink: #8a2a05; --btn-bg: #14110f; --btn-fg: #faf7f2;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #121110; --surface: #1c1a18; --text: #f3efe8; --muted: #a9a198; --line: #2e2a26;
          --accent: #ff7a45; --accent-text: #ff9a6b; --tint: #2a1c14;
          --badge-bg: #3a2216; --badge-ink: #ffb08a; --btn-bg: #f3efe8; --btn-fg: #14110f;
        }
      }
      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body {
        margin: 0; background: var(--bg); color: var(--text);
        font-family: "Hiragino Sans", "Hiragino Kaku Gothic ProN", "Yu Gothic UI", "Meiryo", system-ui, sans-serif;
        line-height: 1.85; counter-reset: sec;
      }
      a { color: var(--accent-text); }
      a:focus-visible, .btn:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }
      .wrap { max-width: 900px; margin: 0 auto; padding: 0 20px; }

      .site-header { border-bottom: 1px solid var(--line); }
      .site-header .wrap { display: flex; justify-content: space-between; align-items: center; padding-top: 14px; padding-bottom: 14px; }
      .logo { display: inline-flex; align-items: center; gap: 10px; font-size: 1.15rem; font-weight: 800; color: var(--text); text-decoration: none; letter-spacing: 0.04em; }
      .logo svg rect { fill: var(--text); }
      .logo svg path { stroke: var(--bg); }
      .nav a { margin-left: 20px; color: var(--muted); text-decoration: none; font-size: 0.92rem; }
      .nav a:hover { color: var(--text); text-decoration: underline; text-underline-offset: 4px; }

      .hero { border-bottom: 1px solid var(--line); }
      .hero-inner { max-width: 900px; margin: 0 auto; padding: 56px 20px 48px; display: grid; grid-template-columns: 1fr auto; gap: 32px; align-items: center; }
      .hero .eyebrow { margin: 0 0 10px; font-size: 0.8rem; font-weight: 800; letter-spacing: 0.14em; color: var(--accent-text); text-transform: uppercase; }
      .hero h1 { margin: 0 0 14px; font-size: clamp(1.7rem, 4.6vw, 2.7rem); line-height: 1.3; font-weight: 800; letter-spacing: -0.01em; }
      .hero-lead { margin: 0 0 24px; color: var(--muted); max-width: 32em; }
      .hero-panel { background: var(--badge-bg); color: var(--text); border-radius: 24px; width: 300px; height: 240px; display: grid; place-items: center; overflow: hidden; }
      .hero-panel.has-image { width: 360px; height: 260px; }
      .hero-panel img { width: 100%; height: 100%; object-fit: cover; display: block; }
      .hero--photo { position: relative; overflow: hidden; background: #eef1f3; }
      .hero-photo-wrap { position: absolute; inset: 0; }
      .hero-photo { width: 100%; height: 100%; object-fit: cover; object-position: 78% 40%; display: block; }
      .hero-credit { position: absolute; right: 12px; bottom: 10px; background: rgba(255,255,255,0.9); color: #14110f; font-size: 0.82rem; font-weight: 700; line-height: 1.7; padding: 1px 10px; border-radius: 4px; }
      .hero--photo::before { content: ""; position: absolute; inset: 0; z-index: 1; pointer-events: none; background: linear-gradient(90deg, rgba(250,247,242,0.92) 0%, rgba(250,247,242,0.78) 38%, rgba(250,247,242,0) 66%); }
      .hero--photo .hero-inner { position: relative; z-index: 2; grid-template-columns: 1fr; min-height: 440px; padding-top: 64px; padding-bottom: 64px; align-items: center; }
      .hero--photo .hero-text { max-width: 460px; }
      .hero--photo h1 { color: #14110f; }
      .hero--photo .eyebrow { color: #c93d08; }
      .hero--photo .hero-lead { color: #3d3732; }
      .hero--photo .btn { background: #14110f; border-color: #14110f; color: #faf7f2; }
      .hero--photo .btn:hover { background: var(--accent); border-color: var(--accent); color: #14110f; }

      .hero--compact h1 { font-size: clamp(1.4rem, 3.8vw, 2rem); margin-bottom: 8px; }
      .hero--compact .hero-lead { margin-bottom: 0; }
      .hero--photo.hero--compact .hero-inner { min-height: 200px; padding-top: 36px; padding-bottom: 36px; }
      .hero--photo.hero--compact .hero-photo { object-position: 78% 28%; }

      main { max-width: 900px; margin: 0 auto; padding: 32px 20px 64px; }
      h1 { font-size: 1.7rem; line-height: 1.4; margin: 0 0 8px; font-weight: 800; }
      h2 { font-size: 1.15rem; margin: 28px 0 8px; }
      .lead { color: var(--muted); margin: 0 0 24px; }
      .note { background: var(--tint); border-radius: 8px; padding: 12px 16px; font-size: 0.9rem; margin: 0 0 28px; }
      .meta { color: var(--muted); font-size: 0.88rem; }
      .btn { display: inline-block; background: var(--btn-bg); color: var(--btn-fg); padding: 10px 20px; border-radius: 8px; text-decoration: none; font-size: 0.95rem; font-weight: 700; border: 2px solid var(--btn-bg); }
      .btn:hover { background: var(--accent); border-color: var(--accent); color: #14110f; }

      .band { display: flex; align-items: baseline; gap: 14px; margin: 64px 0 22px; padding: 0 0 8px; border-bottom: 2px solid var(--text); font-size: 1.55rem; font-weight: 800; letter-spacing: -0.01em; scroll-margin-top: 16px; }
      .band::before { counter-increment: sec; content: counter(sec, decimal-leading-zero); color: var(--accent-text); font-size: 0.95rem; font-weight: 800; letter-spacing: 0.1em; }
      .toc { border-left: 3px solid var(--accent); padding: 4px 0 4px 18px; margin: 0 0 8px; }
      .toc-title { margin: 0 0 4px; font-weight: 800; font-size: 0.9rem; letter-spacing: 0.1em; color: var(--muted); }
      .toc ol { margin: 0; padding-left: 1.4rem; }
      .toc a { color: var(--text); text-decoration: none; }
      .toc a:hover { text-decoration: underline; text-underline-offset: 4px; }

      .cards { list-style: none; padding: 0; margin: 0; display: grid; gap: 20px; }
      .card { background: var(--surface); border: 1px solid var(--line); border-radius: 14px; padding: 22px; display: grid; gap: 10px; }
      .card.product { grid-template-columns: 190px 1fr; gap: 24px; align-items: start; }
      .card-art { margin: 0; min-height: 170px; border-radius: 10px; background: var(--badge-bg); color: var(--text); display: grid; place-items: center; align-content: center; gap: 8px; padding: 14px 10px; text-align: center; }
      .card-art figcaption { color: var(--muted); font-size: 0.72rem; line-height: 1.5; }
      .card-body { display: grid; gap: 10px; min-width: 0; }
      .card-top { display: flex; align-items: center; flex-wrap: wrap; gap: 10px; }
      .no { font-size: 0.9rem; font-weight: 800; color: var(--accent-text); letter-spacing: 0.1em; }
      .badge { display: inline-block; background: var(--badge-bg); color: var(--badge-ink); border-radius: 999px; padding: 2px 12px; font-size: 0.82rem; font-weight: 700; }
      .maker { display: inline-block; border: 1px solid var(--line); color: var(--muted); border-radius: 6px; padding: 0 8px; font-size: 0.78rem; font-weight: 700; letter-spacing: 0.04em; }
      .card-name { margin: 0; font-size: 1.4rem; line-height: 1.4; font-weight: 800; }
      .card-name a { color: var(--text); }
      .card-tagline { margin: 0; color: var(--muted); }
      .chips { list-style: none; padding: 0; margin: 4px 0; display: flex; flex-wrap: wrap; gap: 8px; }
      .chip { display: inline-flex; align-items: center; gap: 6px; border: 1px solid var(--line); border-radius: 999px; padding: 3px 14px; font-size: 0.88rem; }
      .chip svg { color: var(--accent-text); }
      .chip-label { color: var(--muted); }
      .card-for { margin: 0; font-size: 0.95rem; }
      .card-for strong { margin-right: 6px; }
      .card-bottom { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12px; border-top: 1px solid var(--line); padding-top: 14px; margin-top: 4px; }
      .price strong { font-size: 1.2rem; margin-right: 6px; }

      .features { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 16px; margin: 0 0 8px; padding: 0; list-style: none; }
      .feature { border-top: 2px solid var(--text); padding: 14px 4px 0; }
      .feature svg { color: var(--accent-text); }
      .feature h3 { margin: 8px 0 4px; font-size: 1.05rem; }
      .feature p { margin: 0; color: var(--muted); font-size: 0.92rem; }

      .flows { border: 1px solid var(--line); background: var(--surface); border-radius: 14px; padding: 18px 20px; display: grid; gap: 14px; }
      .flow-label { margin: 0 0 6px; font-weight: 800; }
      .flow { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 8px; }
      .step { background: var(--bg); border: 1px solid var(--line); border-radius: 8px; padding: 6px 12px; font-size: 0.92rem; }
      .step.hl { background: var(--badge-bg); border-color: transparent; color: var(--badge-ink); font-weight: 700; }
      .arrow { color: var(--muted); }

      .bars { border: 1px solid var(--line); background: var(--surface); border-radius: 14px; padding: 16px 20px 18px; margin: 0 0 16px; }
      .bars-title { margin: 0 0 4px; font-size: 1.05rem; }
      .bars-list { list-style: none; padding: 0; margin: 10px 0 0; display: grid; gap: 10px; }
      .bar-row { display: grid; grid-template-columns: 10em 1fr 6.5em; align-items: center; gap: 12px; }
      .bar-name { font-weight: 700; font-size: 0.92rem; }
      .bar-track { background: var(--line); border-radius: 999px; height: 12px; overflow: hidden; }
      .bar-fill { display: block; height: 100%; border-radius: 999px; background: var(--text); opacity: 0.8; }
      .bar-fill.is-best { background: var(--accent); opacity: 1; }
      .bar-val { text-align: right; font-weight: 700; white-space: nowrap; }

      .table-wrap { overflow-x: auto; border: 1px solid var(--line); border-radius: 12px; background: var(--surface); }
      table { border-collapse: collapse; width: 100%; min-width: 560px; }
      th, td { padding: 12px 16px; text-align: left; border-bottom: 1px solid var(--line); white-space: nowrap; }
      thead th { background: var(--tint); }
      tbody tr:last-child td, tbody tr:last-child th { border-bottom: 0; }
      .pending { color: var(--muted); }
      .best { color: var(--accent-text); font-weight: 800; }
      .sources { font-size: 0.85rem; color: var(--muted); margin: 16px 0 0; padding-left: 1.2rem; }
      .tabs { display: flex; gap: 8px; margin: 0 0 20px; }
      .tabs a { padding: 6px 16px; border: 1px solid var(--line); border-radius: 999px; text-decoration: none; color: var(--text); background: var(--surface); }
      .tabs a[aria-current="page"] { background: var(--btn-bg); border-color: var(--btn-bg); color: var(--btn-fg); font-weight: 700; }

      .site-footer { border-top: 1px solid var(--line); color: var(--muted); font-size: 0.85rem; }
      .site-footer .wrap { padding-top: 22px; padding-bottom: 36px; }
      .site-footer .links a { margin-right: 16px; }

      @media (max-width: 640px) {
        .hero-inner { grid-template-columns: 1fr; padding: 36px 20px 32px; }
        .hero-panel, .hero-panel.has-image { width: 100%; height: 200px; }
        .hero-panel svg { width: 190px; }
        .nav a { margin-left: 12px; }
        .hero--photo { background: var(--bg); }
        .hero--photo::before { display: none; }
        .hero--photo .hero-photo-wrap { position: relative; height: 230px; }
        .hero--photo .hero-photo { object-position: 82% 30%; }
        .hero--photo .hero-inner { min-height: 0; padding: 26px 20px 32px; }
        .hero--photo h1 { color: var(--text); }
        .hero--photo .eyebrow { color: var(--accent-text); }
        .hero--photo .hero-lead { color: var(--muted); }
        .hero--photo .btn { background: var(--btn-bg); border-color: var(--btn-bg); color: var(--btn-fg); }
        .hero--photo.hero--compact .hero-photo-wrap { height: 150px; }
        .hero--photo.hero--compact .hero-inner { padding: 20px 20px 24px; }
        .band { font-size: 1.3rem; margin-top: 48px; }
        .card.product { grid-template-columns: 1fr; }
        .card-art { min-height: 120px; }
        .bar-row { grid-template-columns: 1fr auto; }
        .bar-track { grid-column: 1 / -1; order: 3; }
      }
    </style>
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="logo" href="/">
          <svg viewBox="0 0 32 32" width="28" height="28" aria-hidden="true"><rect width="32" height="32" rx="8"/><path d="M9 21c0-7 3-10 7-10s7 3 7 10" fill="none" stroke-width="3" stroke-linecap="round"/></svg>
          ギアクラブ
        </a>
        <nav class="nav" aria-label="サイト内の移動">
          <a href="/">トップ</a>
          <a href="/bone-conduction/">骨伝導イヤホン</a>
        </nav>
      </div>
    </header>
    <slot name="hero" />
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <p>当サイトはアフィリエイト広告を利用しています。商品リンクから購入されると、運営者に報酬が入ることがあります。</p>
        <p class="links"><a href="/about/">運営者情報</a><a href="/privacy/">プライバシーポリシー</a></p>
      </div>
    </footer>
  </body>
</html>
