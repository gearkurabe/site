---
const { products, specKey, title, unit = '', better = 'max', note = '' } = Astro.props;
const num = (v) => parseFloat(String(v).replace(/[^0-9.]/g, ''));
const items = products
  .map((p) => {
    const v = p.specs && p.specs[specKey];
    return v && v.verified === true && !Number.isNaN(num(v.value))
      ? { name: p.name, text: `${v.value}${unit}`, n: num(v.value) }
      : null;
  })
  .filter(Boolean)
  .sort((a, b) => (better === 'max' ? b.n - a.n : a.n - b.n));
const maxN = Math.max(...items.map((i) => i.n), 1);
---
{items.length > 0 && (
  <div class="bars">
    <h3 class="bars-title">{title}</h3>
    {note && <p class="meta">{note}</p>}
    <ul class="bars-list">
      {items.map((it, i) => (
        <li class="bar-row">
          <span class="bar-name">{it.name}</span>
          <span class="bar-track" aria-hidden="true">
            <span class:list={['bar-fill', i === 0 && 'is-best']} style={`width:${Math.round((it.n / maxN) * 100)}%`}></span>
          </span>
          <span class="bar-val">{it.text}{i === 0 && ' ◎'}</span>
        </li>
      ))}
    </ul>
  </div>
)}
