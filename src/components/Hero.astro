---
import site from '../data/site.json';
const { title, lead = '', eyebrow = '', image = site.heroImage } = Astro.props;
---
<section class:list={['hero', image && 'hero--photo']}>
  {image && (
    <div class="hero-photo-wrap">
      <img
        class="hero-photo"
        src={image}
        srcset={`${site.heroImageSmall} 800w, ${site.heroImage} 1400w`}
        sizes="100vw"
        alt={site.heroImageAlt}
        width="1400"
        height="788"
        fetchpriority="high"
        decoding="async"
      />
      <span class="hero-credit">{site.heroImageCredit}</span>
    </div>
  )}
  <div class="hero-inner">
    <div class="hero-text">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1>{title}</h1>
      {lead && <p class="hero-lead">{lead}</p>}
      <slot />
    </div>
    {!image && (
      <div class="hero-panel" aria-hidden="true">
        <svg viewBox="0 0 220 160" width="210" focusable="false">
          <path d="M50 28 C50 128 170 128 170 28" fill="none" stroke="currentColor" stroke-width="8" stroke-linecap="round" />
          <circle cx="50" cy="28" r="13" fill="#ff5a1f" />
          <circle cx="170" cy="28" r="13" fill="#ff5a1f" />
          <path d="M26 12 a34 34 0 0 0 0 32" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" opacity="0.55" />
          <path d="M14 4 a48 48 0 0 0 0 48" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" opacity="0.28" />
          <path d="M194 12 a34 34 0 0 1 0 32" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" opacity="0.55" />
          <path d="M206 4 a48 48 0 0 1 0 48" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" opacity="0.28" />
        </svg>
      </div>
    )}
  </div>
</section>
