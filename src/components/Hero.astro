---
const { title, lead = '', eyebrow = '' } = Astro.props;
---
<section class="hero">
  <div class="hero-inner">
    <div class="hero-text">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1>{title}</h1>
      {lead && <p class="hero-lead">{lead}</p>}
      <slot />
    </div>
    <svg class="hero-art" viewBox="0 0 220 160" aria-hidden="true" focusable="false">
      <path d="M50 28 C50 128 170 128 170 28" fill="none" stroke="#ffffff" stroke-width="8" stroke-linecap="round" opacity="0.92" />
      <circle cx="50" cy="28" r="13" fill="#f0a35e" />
      <circle cx="170" cy="28" r="13" fill="#f0a35e" />
      <path d="M26 12 a34 34 0 0 0 0 32" fill="none" stroke="#ffffff" stroke-width="3" stroke-linecap="round" opacity="0.55" />
      <path d="M14 4 a48 48 0 0 0 0 48" fill="none" stroke="#ffffff" stroke-width="3" stroke-linecap="round" opacity="0.3" />
      <path d="M194 12 a34 34 0 0 1 0 32" fill="none" stroke="#ffffff" stroke-width="3" stroke-linecap="round" opacity="0.55" />
      <path d="M206 4 a48 48 0 0 1 0 48" fill="none" stroke="#ffffff" stroke-width="3" stroke-linecap="round" opacity="0.3" />
    </svg>
  </div>
</section>
