---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import genres from '../../data/genres.json';
import details from '../../data/details.json';

export function getStaticPaths() {
  const paths = [];
  for (const [slug, g] of Object.entries(genres)) {
    for (const p of g.products) {
      paths.push({ params: { genre: slug, id: p.id }, props: { g, p } });
    }
  }
  return paths;
}

const { g, p } = Astro.props;
const { genre } = Astro.params;
const d = details[p.id] || {};
const verified = (s) => {
  const v = p.specs && p.specs[s.key];
  return v && v.verified === true ? `${v.value}${s.unit}` : '確認中';
};
const others = g.products.filter((x) => x.id !== p.id);
const cell = (x, s) => {
  const v = x.specs && x.specs[s.key];
  return v && v.verified === true ? `${v.value}${s.unit}` : '確認中';
};
---
<Base title={`${p.name}のスペックと特徴`} description={`${p.name}の確認済みスペック、特徴、気をつけたい点をまとめます。${p.tagline}`}>
  <Hero slot="hero" compact eyebrow={p.maker} title={p.name} lead={p.tagline} />

  <p class="meta"><a href={`/${genre}/`}>{g.headline}</a> &gt; {p.name}</p>
  <p class="note">{p.link && p.link.ad && 'このページには広告(アフィリエイトリンク)が含まれます。'}スペックは、メーカー公式または販売元の情報で確認できた値です。「こんな人に」と気をつけたい点は、運営者の見立てを含みます。実際に使った感想ではありません。</p>

  <nav class="toc" aria-label="目次">
    <p class="toc-title">目次</p>
    <ol>
      <li><a href="#summary">どんな製品か</a></li>
      <li><a href="#spec">確認済みのスペック</a></li>
      <li><a href="#for">こんな人に向いています</a></li>
      <li><a href="#caution">気をつけたい点</a></li>
      <li><a href="#vs">他の2製品と比べる</a></li>
      <li><a href="#price">参考価格と販売ページ</a></li>
    </ol>
  </nav>

  <h2 class="band" id="summary">どんな製品か</h2>
  <p><span class="badge">{p.badge}</span> <span class="maker">{p.maker}</span></p>
  <p>{d.summary || p.tagline}</p>
  <p><strong>こんな人に:</strong>{p.bestFor}</p>

  <h2 class="band" id="spec">確認済みのスペック</h2>
  <div class="table-wrap">
    <table class="diff">
      <thead><tr><th scope="col">項目</th><th scope="col">内容</th></tr></thead>
      <tbody>
        {g.specs.map((s) => (
          <tr><th scope="row">{s.label}</th><td>{verified(s)}</td></tr>
        ))}
        {(d.extraSpecs || []).map((r) => (
          <tr><th scope="row">{r.label}</th><td>{r.value}</td></tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="meta">確認できていない項目は「確認中」と表示します。スペックの見方は、<a href="/how-to-choose/">選び方5つ</a>で説明しています。</p>

  <h2 class="band" id="for">こんな人に向いています</h2>
  <p>ここは、運営者の見立てです。</p>
  <ul>
    {(d.forWhom || [p.bestFor]).map((t) => <li>{t}</li>)}
  </ul>
  <p>使う場面別の記事も、あわせてご覧ください。<a href="/commute/">通勤・外出</a>、<a href="/exercise/">運動</a>、<a href="/online-meeting/">オンライン会議・在宅</a>。</p>

  <h2 class="band" id="caution">気をつけたい点</h2>
  <ul>
    {(d.cautions || []).map((t) => <li>{t}</li>)}
    <li>音量を上げすぎないようにしてください。道路や自転車での使用は、地域の規則や交通ルールを確認してください。</li>
    <li>聞こえに不安がある場合は、自己判断せず、医師に相談してください。このページは、聞こえに関する医療的な助言ではありません。</li>
  </ul>

  <h2 class="band" id="vs">他の2製品と比べる</h2>
  <div class="table-wrap">
    <table class="diff">
      <thead>
        <tr>
          <th scope="col">製品</th>
          {g.specs.map((s) => <th scope="col">{s.label}</th>)}
        </tr>
      </thead>
      <tbody>
        <tr>
          <th scope="row">{p.name}(このページ)</th>
          {g.specs.map((s) => <td>{cell(p, s)}</td>)}
        </tr>
        {others.map((x) => (
          <tr>
            <th scope="row"><a href={`/${genre}/${x.id}/`}>{x.name}</a></th>
            {g.specs.map((s) => <td>{cell(x, s)}</td>)}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p>詳しい比較は、<a href={`/${genre}/compare/`}>比較表</a>をご覧ください。</p>

  <h2 class="band" id="price">参考価格と販売ページ</h2>
  {p.referencePrice
    ? <p><strong>{p.referencePrice.amount.toLocaleString('ja-JP')}円</strong>(参考価格・{p.referencePrice.checkedAt}時点・{p.referencePrice.source})</p>
    : <p>価格は、販売ページでご確認ください。</p>}
  <p>価格・在庫・ポイントは、セールなどで変動します。購入前に、販売ページで必ずご確認ください。</p>
  {p.link && <p><a class="btn" href={p.link.url} target="_blank" rel={p.link.ad ? 'sponsored nofollow noopener' : 'nofollow noopener'}>{p.link.label}{p.link.ad && '(広告)'}</a></p>}

  <h2 class="band">出典</h2>
  <ul class="sources">
    {(d.sources || []).map((s) => (
      <li><a href={s.url} target="_blank" rel="noopener nofollow">{s.label}</a>:{s.note}(確認日 2026-11-28)</li>
    ))}
    {p.specSource && <li>主要スペック(連続再生・重さ・防水等級)の出典:<a href={p.specSource.url} target="_blank" rel="noopener nofollow">{p.specSource.label}</a>(確認日 {p.specSource.checkedAt})</li>}
  </ul>
  <p class="meta">このページは、公開情報をもとにした整理で、実際に使った感想ではありません。</p>
</Base>
