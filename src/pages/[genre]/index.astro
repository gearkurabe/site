---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import ProductCard from '../../components/ProductCard.astro';
import genres from '../../data/genres.json';

export function getStaticPaths() {
  return Object.entries(genres).map(([slug, g]) => ({ params: { genre: slug }, props: { g } }));
}

const { g } = Astro.props;
const { genre } = Astro.params;
const hasAd = g.products.some((p) => p.link && p.link.ad);
---
<Base title={g.headline} description={g.description}>
  <Hero slot="hero" eyebrow={g.name.toUpperCase() === g.name ? g.name : '骨伝導イヤホン'} title={g.headline} lead={g.description} />
  <nav class="tabs" aria-label="表示の切り替え">
    <a href={`/${genre}/`} aria-current="page">おすすめ</a>
    <a href={`/${genre}/compare/`}>比較表</a>
  </nav>
  <p class="note">{hasAd && 'このページには広告(アフィリエイトリンク)が含まれます。'}タイプの違いで{g.products.length}つを選びました。順番は優劣ではありません。「こんな人に」とデザインの感想は運営者の見立てで、スペックは確認した値です。</p>
  <ol class="cards">
    {g.products.map((p, i) => <ProductCard p={p} n={i + 1} specs={g.specs} />)}
  </ol>
  <p class="meta" style="margin-top:20px">価格は変動します。最新の価格・在庫は、販売ページでご確認ください。スペックの出典と確認日は、<a href={`/${genre}/compare/`}>比較表</a>のページに載せています。</p>
</Base>
