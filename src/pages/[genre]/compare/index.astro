---
import Base from '../../../layouts/Base.astro';
import genres from '../../../data/genres.json';

export function getStaticPaths() {
  return Object.entries(genres).map(([slug, g]) => ({ params: { genre: slug }, props: { g } }));
}

const { g } = Astro.props;
const { genre } = Astro.params;
const fmt = (v, unit) => (typeof v === 'number' ? v.toLocaleString('ja-JP') : v) + unit;
---
<Base title={`${g.name}の比較表`} description={g.description}>
  <nav class="tabs" aria-label="表示の切り替え">
    <a href={`/${genre}/`}>ランキング</a>
    <a href={`/${genre}/compare/`} aria-current="page">比較表</a>
  </nav>
  <h1>{g.name}の比較表</h1>
  <p class="lead">スペックを横に並べて比べられます。</p>
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th scope="col">商品</th>
          {g.specs.map((s) => <th scope="col">{s.label}</th>)}
        </tr>
      </thead>
      <tbody>
        {g.products.map((p) => (
          <tr>
            <th scope="row">{p.name}</th>
            {g.specs.map((s) => <td>{fmt(p[s.key], s.unit)}</td>)}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</Base>
