---
import Base from '../../../layouts/Base.astro';
import genres from '../../../data/genres.json';

export function getStaticPaths() {
  return Object.entries(genres).map(([slug, g]) => ({ params: { genre: slug }, props: { g } }));
}

const { g } = Astro.props;
const { genre } = Astro.params;

// 確認済み(verified: true)の値だけを表示し、それ以外は「確認中」にする
const specCell = (p, s) => {
  const v = p.specs && p.specs[s.key];
  return v && v.verified === true
    ? { text: `${v.value}${s.unit}`, ok: true }
    : { text: '確認中', ok: false };
};
---
<Base title={`${g.name}の比較表`} description={g.description}>
  <nav class="tabs" aria-label="表示の切り替え">
    <a href={`/${genre}/`}>ランキング</a>
    <a href={`/${genre}/compare/`} aria-current="page">比較表</a>
  </nav>
  <h1>{g.name}の比較表</h1>
  <p class="lead">スペックを横に並べて比べられます。</p>
  <p class="note">スペックは、メーカー公式または販売元の情報で確認できた値だけを掲載しています。確認できていない項目は「確認中」と表示します。価格は参考価格で、変動します。最新の価格は、販売ページでご確認ください。</p>
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th scope="col">商品</th>
          <th scope="col">参考価格</th>
          {g.specs.map((s) => <th scope="col">{s.label}</th>)}
        </tr>
      </thead>
      <tbody>
        {g.products.map((p) => (
          <tr>
            <th scope="row">{p.name}</th>
            <td>
              {p.referencePrice
                ? <span>{p.referencePrice.amount.toLocaleString('ja-JP')}円<br /><span class="meta">{p.referencePrice.checkedAt}時点・{p.referencePrice.source}</span></span>
                : <span class="pending">-</span>}
            </td>
            {g.specs.map((s) => {
              const c = specCell(p, s);
              return <td class:list={[!c.ok && 'pending']}>{c.text}</td>;
            })}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <ul class="sources">
    {g.products.filter((p) => p.specSource).map((p) => (
      <li>{p.name}のスペック出典:<a href={p.specSource.url} rel="noopener nofollow">{p.specSource.label}</a>(確認日 {p.specSource.checkedAt})</li>
    ))}
  </ul>
</Base>
